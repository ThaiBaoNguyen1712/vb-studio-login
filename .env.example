# ==========================================================
# VB-Login Configuration
# ==========================================================

# Storage mode: 'LOCAL' (sử dụng JSON/SQLite cục bộ khi chưa có DB) hoặc 'POSTGRES'
STORAGE_MODE=LOCAL

# Tên thành viên sử dụng phiên này (Team 3-4 người)
# Ví dụ: Nam, Lan, Tuan, Trang
CURRENT_USER_NAME=Member_01

# Đường dẫn thư mục lưu Browser Persistent Profiles
PROFILES_DIR=./profiles

# Cấu hình PostgreSQL VPS (Thiết lập khi kết nối)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vb_login_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Cấu hình GitHub Repository để tự động check version & update
# Format: owner/repo (Ví dụ: your-username/vb-login)
GITHUB_REPO=your-username/vb-login

